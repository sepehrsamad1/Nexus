# Local SQLite Database (Zero-config)
DATABASE_URL="file:./dev.db"

# Authentication Secrets
NEXTAUTH_SECRET="super-secret-local-dev-key"
NEXTAUTH_URL="http://localhost:3000"

# Optional: E-Commerce Stripe Integration
# STRIPE_SECRET_KEY="sk_test_..."

# Optional P10 public-source integrations (disabled by default; no credentials required for the default app)
NEXUS_EXTERNAL_INTEGRATIONS_ENABLED="false"
NEXUS_EXTERNAL_CACHE_HOURS="24"
NEXUS_YOUTUBE_TRAILER_ADAPTER_ENABLED="false"
NEXUS_YOUTUBE_TRAILER_URLS_JSON="[]"
NEXUS_REDDIT_ADAPTER_ENABLED="false"
NEXUS_REDDIT_REFERENCE_URLS_JSON="[]"
# Reddit external Data API access is optional and must be supplied by an approved integration.
# REDDIT_ACCESS_TOKEN=""
