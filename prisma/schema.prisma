generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  image               String?
  role                String    @default("USER") // 'USER' | 'STREAMER' | 'EXPERT' | 'ADMIN'
  twitchUrl           String?
  youtubeUrl          String?
  bio                 String?
  createdAt           DateTime  @default(now())

  reviews             Review[]
  comments            Comment[]
  votes               Vote[]
  orders              Order[]
  recommendedProducts Product[] @relation("StreamerRecommendations")
  creatorProfile      CreatorProfile?
  creatorPosts        CreatorPost[]
  followers           CreatorFollow[] @relation("CreatorFollowers")
  following           CreatorFollow[] @relation("CreatorFollowing")
}

model Game {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String
  coverImage      String
  bannerImage     String?
  releaseDate     DateTime
  developer       String
  publisher       String
  platformsJson   String    @default("[]")
  genresJson      String    @default("[]")
  expertScore     Float     @default(0)
  streamerScore   Float     @default(0)
  userScore       Float     @default(0)
  overallScore    Float     @default(0)
  reviewCount     Int       @default(0)
  discussionCount Int       @default(0)
  digitalPrice    Float     @default(59.99)
  stockKeysJson   String    @default("[]")
  createdAt       DateTime  @default(now())

  reviews         Review[]
  comments        Comment[]
  relatedProducts Product[] @relation("GameRelatedProducts")
}

model Review {
  id             String    @id @default(cuid())
  gameId         String
  authorId       String
  roleAtCreation String    @default("USER")
  score          Int
  title          String
  content        String
  prosJson       String    @default("[]")
  consJson       String    @default("[]")
  videoUrl       String?
  upvotes        Int       @default(0)
  downvotes      Int       @default(0)
  createdAt      DateTime  @default(now())

  game           Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments       Comment[]
  votes          Vote[]
}

model CreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String
  handle          String   @unique
  tagline         String?
  bio             String?
  isDemoEditorial Boolean  @default(true)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreatorPost {
  id         String   @id @default(cuid())
  authorId   String
  title      String
  content    String
  isDemo     Boolean  @default(true)
  createdAt  DateTime @default(now())

  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
}

model CreatorFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("CreatorFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("CreatorFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  reviewId  String?
  gameId    String?
  authorId  String
  parentId  String?
  content   String
  upvotes   Int       @default(0)
  downvotes Int       @default(0)
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())

  review    Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  game      Game?     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  votes     Vote[]

  @@index([gameId, parentId, createdAt])
  @@index([reviewId, parentId, createdAt])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String?
  commentId String?
  value     Int
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@unique([userId, commentId])
}
